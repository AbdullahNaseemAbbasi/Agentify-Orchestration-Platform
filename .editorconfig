# EditorConfig — https://editorconfig.org
# Keeps every editor (VSCode, JetBrains, Sublime, Vim, etc.) consistent.

# Top-most config in the project — editors stop searching higher.
root = true

# Defaults for every file in the repo
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown allows trailing whitespace (used for line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab

# YAML in particular is whitespace-sensitive — explicit
[*.{yml,yaml}]
indent_size = 2

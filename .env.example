# =============================================================
# Agentify environment variables — copy this file to `.env`
# and fill in real values for your environment.
#
#    cp .env.example .env
#
# NEVER commit `.env` (it is in .gitignore).
# =============================================================

# ----- App -----
NODE_ENV=development
PORT=3000

# ----- PostgreSQL -----
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://agentify:password@localhost:5433/agentify

# ----- Redis -----
REDIS_URL=redis://localhost:6381

# ----- Object storage (MinIO locally, S3 in prod) -----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentify-dev
S3_REGION=us-east-1

# ----- JWT (auth) — generate with: openssl rand -base64 32 -----
JWT_PRIVATE_KEY=replace-me-with-long-random-string
JWT_PUBLIC_KEY=replace-me-with-matching-public-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ----- LLM providers (add as you integrate them) -----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ----- Observability (Phase 2) -----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=info

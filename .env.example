# =============================================================
# Agentify environment variables — copy this file to `.env`
# and fill in real values for your environment.
#
#    cp .env.example .env
#
# NEVER commit `.env` (it is in .gitignore).
# =============================================================

# ----- App -----
NODE_ENV=development
PORT=3000

# ----- PostgreSQL -----
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://agentify:password@localhost:5433/agentify

# ----- Redis -----
REDIS_URL=redis://localhost:6381

# ----- Object storage (MinIO locally, S3 in prod) -----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentify-dev
S3_REGION=us-east-1

# ----- JWT (auth) -----
# Generate the RSA-4096 keypair once with:
#     npm run keys:generate
# That writes keys/jwt-private.pem and keys/jwt-public.pem (gitignored).
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=agentify
JWT_AUDIENCE=agentify-api

# ----- LLM providers (add as you integrate them) -----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ----- Observability (Phase 2) -----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=info

{
  "name": "agentify",
  "version": "0.0.1",
  "description": "Self-hostable AI agent orchestration platform",
  "private": true,
  "license": "UNLICENSED",
  "author": "Abdullah Naseem",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "test": "echo 'test: not configured yet'",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,json,md}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.{ts,json,md}\" \"*.{ts,json,md}\"",
    "prisma:generate": "prisma generate --schema=libs/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=libs/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=libs/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=libs/database/prisma/schema.prisma",
    "keys:generate": "ts-node scripts/generate-jwt-keys.ts"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}

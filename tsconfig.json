{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@agentify/common": ["libs/common/src"],
      "@agentify/common/*": ["libs/common/src/*"],
      "@agentify/database": ["libs/database/src"],
      "@agentify/database/*": ["libs/database/src/*"],
      "@agentify/llm": ["libs/llm/src"],
      "@agentify/llm/*": ["libs/llm/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
